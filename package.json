{
  "name": "biblhalla",
  "version": "0.3.0",
  "private": true,
  "description": "Biblhalla by Kendrew Games: an offline biblical arena fighter and Story Archive campaign",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "content": "node tools/compile-content.ts",
    "build": "node tools/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:prototype": "node --test prototype/tests/simulation.test.cjs",
    "validate:content": "node tools/compile-content.ts --check",
    "serve": "node tools/serve.ts",
    "bots": "node tools/bot-harness.ts",
    "art:check": "node tools/art/validate-art.ts",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.28.2",
    "pngjs": "7.0.0",
    "typescript": "7.0.2"
  }
}
